# ==============================================================================
# AFFINITY ACADEMY — SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase project keys.
# NEVER commit .env.local or your service_role key to version control.
# ==============================================================================

# Project URL (Found under Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (Safe for client-side browser exposure with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

# NOTE:
# If these environment variables are omitted or contain placeholder values,
# the application automatically operates in resilient Offline/Local Mode
# using browser localStorage and mock sessions.
